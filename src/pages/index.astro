---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import Member from '../components/Member.astro';
import BactaCanvas from '../components/BactaCanvas.astro';
import MiniProgram from '../components/MiniProgram.astro';

import IconCaretRightBold from '../assets/images/icons/phosphor/caret-right-bold.svg';
import IconHandWaving from '../assets/images/icons/phosphor/hand-waving.svg';
import LogoAlphaOmega from '../assets/images/logos/alphaomega.svg';
import LogoChaoss from '../assets/images/logos/chaoss.svg';
import LogoEcosystems from '../assets/images/logos/ecosystems.svg';
import LogoEpfl from '../assets/images/logos/epfl.svg';
import LogoGatesFoundation from '../assets/images/logos/gatesfoundation.svg';
import LogoGitHub from '../assets/images/logos/github.svg';
import LogoIntel from '../assets/images/logos/intel.svg';
import LogoLibrariesIo from '../assets/images/logos/librariesio.svg';
import LogoLinuxFoundation from '../assets/images/logos/linuxfoundation.svg';
import LogoNpmx from '../assets/images/logos/npmx.svg';
import LogoNuxt from '../assets/images/logos/nuxt.svg';
import LogoNyu from '../assets/images/logos/nyu.svg';
import LogoOpenSsf from '../assets/images/logos/openssf.svg';
import LogoOse from '../assets/images/logos/ose.svg';
import LogoOsp from '../assets/images/logos/osp.svg';
import LogoSta from '../assets/images/logos/sta.svg';
import LogoThanksDev from '../assets/images/logos/thanksdev.svg';
import LogoVite from '../assets/images/logos/vite.svg';
import LogoVmware from '../assets/images/logos/vmware.svg';
import Star from '../assets/images/star.svg';

const programs = (await getCollection('programs'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((d) => {
    return {
      id: d.id,
      ...d.data
    };
  });
---

<MainLayout>
  <div class="pagepad">
    <div class="container">
      <section>
        <h1 class="visually-hidden">Software Stewardship Lab</h1>
        <div class="hero">
          <Star class="squiggle squiggle--mobile squiggle--hero" />
          <h2 class="sechead">
            <small>A new non-profit applied research lab</small>
            <hr class="hr--short">
            We ensure the stability of the Open&nbsp;Source ecosystem we all rely on.
          </h2>
        </div>
        <div class="subhero">
          <div class="feature-set">
            <div class="feature">
              <p>
                Without
                <a
                  href="https://opensource.com/resources/what-open-source"
                  target="_blank"
                >Open Source</a>
                software, our critical infrastructure would break. This includes transportation, healthcare and the
                internet.
              </p>
              <p>
                But the Open Source software we rely on is in crisis. It's developed by
                <a
                  href="/reports/burnout-in-open-source-a-structural-problem-we-can-fix-together"
                >burnout-prone unpaid volunteers</a>
                with
                <a
                  href="https://openpath.quest/2024/the-open-source-sustainability-crisis/"
                  target="_blank"
                >insufficient funding</a>
                or institutional support. And it faces systematic
                <a
                  href="https://arstechnica.com/security/2024/04/what-we-know-about-the-xz-utils-backdoor-that-almost-infected-the-world/"
                  target="_blank"
                >supply chain security threats</a>.
              </p>
              <p>
                Unsustainably developed Open Source software can break or
                <a
                  href="https://en.wikipedia.org/wiki/Npm_left-pad_incident"
                  target="_blank"
                >disappear</a>,
                threatening the critical infrastructure the public depends on.
              </p>
            </div>
            <hr class="hr--short hr--blue">
            <div class="feature">
              <p>
                <strong>
                  We care for the Open Source technology we all rely on, thereby protecting our global
                  infrastructure.
                </strong>
              </p>
              <p>
                We develop ways to make the Open Source ecosystem more secure, sustainably funded, and responsibly
                governed, by producing software, APIs, research reports, and peer-reviewed papers.
              </p>
              <p>
                Our work on <mark>supply chain security</mark> enables developers to protect vulnerable projects. And
                our work on <mark>sustainable funding and governance</mark> has helped maintainers avoid burnout and
                continue their critical work.
              </p>
            </div>
          </div>
          <figure class="postcard">
            <img
              class="postcard__main"
              src="https://static.stewardshiplab.org/AltCtrOrg-Event-115@1400px.webp"
              alt="Vlad presenting in front of an audience"
              width="1400"
              height="933"
              fetchpriority="high"
            >
            <figcaption>
              Vlad speaking at AltCtrlOrg in Basel, Switzerland
              &middot;
              <span class="text-pale">Photo by Kostas&nbsp;Fryganiotis</span>
            </figcaption>
          </figure>
        </div>
        <a
          class="news-item plain-link"
          href="https://podcast.sustainoss.org/292"
          target="_blank"
        >
          <div class="news-item__body">
            <img
              class="news-item__graphic"
              width="65"
              height="65"
              src="https://vlad.website/static/sustain-292@600px.webp"
              alt="Sustain Episode 292"
            >
            <div class="news-item__text">
              <h2>Listen to our Sustain podcast episode</h2>
              <em class="news-item__extra">“Launching the Software Stewardship Lab”</em>
            </div>
            <IconCaretRightBold class="icon icon--s" />
          </div>
        </a>
      </section>
    </div>
    <section class="section--contrasting section--no-bottom-margin section--no-top-margin">
      <Star class="squiggle squiggle--c" />
      <Star class="squiggle squiggle--d" />
      <Star class="squiggle squiggle--mobile squiggle--section-a" />
      <div class="container">
        <div class="subtitled-heading" id="team">
          <h2>Our Team</h2>
          <p>
            Our team includes some of the world's foremost Open Source sustainability experts.
          </p>
        </div>
        <div class="members">
           <Member
             name="Vlad Miricioiu"
             title="Executive Director, Researcher"
             imageUrl="/images/people/vlad@300px.webp"
             url="https://vlad.website"
           >
             <p>
               Director of the
               <a href="https://opensourcepledge.com">Open Source Pledge</a>,
               which has raised $7,156,281 for maintainers.
               <a href="https://thanks.dev">thanks.dev</a> core developer.
               Helped build software used by the
               <a href="https://gatesfoundation.org">Gates Foundation</a>
               to allocate $1B in healthcare funding.
             </p>
           </Member>
           <Member
             name="Andrew Nesbitt"
             title="Non-Executive Director, Researcher"
             imageUrl="/images/people/andrew@300px.webp"
             url="https://nesbitt.io"
           >
             <p>
               Creator of leading Open Source intelligence providers
               <a href="https://ecosyste.ms">ecosyste.ms</a>
               and
               <a href="https://libraries.io">libraries.io</a>.
               Organiser of the FOSDEM
               <a href="https://fosdem.org/2026/schedule/track/package-management/">Package Management devroom</a>.
               Previously an engineer at
               <a href="https://github.com">GitHub</a>
               and
               <a href="https://tidelift.com">Tidelift</a>.
             </p>
           </Member>
           <Member
             name="Miranda Heath"
             title="Non-Executive Director, Researcher"
             imageUrl="/images/people/miranda@300px.webp"
             url="https://mirandaheath.website"
           >
             <p>
               BPS award-winning psychologist and author of the to-date most comprehensive
               <a href="https://opensourcepledge.com/blog/burnout-in-open-source-a-structural-problem-we-can-fix-together/">report on burnout in Open Source</a>.
               PhD researcher in moral psychology and philosophy at the University of Edinburgh.
             </p>
           </Member>
           <Member
             name="Daniel Roe"
             title="Independent Non-Executive Director"
             imageUrl="/images/people/daniel@300px.webp"
             url="https://roe.dev"
           >
             <p>
               Leader of globally-used web framework <a href="https://nuxt.com/">Nuxt</a>.
               Steward of package manager frontend <a href="https://npmx.dev">npmx</a>.
               Regular keynote speaker. Microsoft MVP, Google GDE, and GitHub Star.
             </p>
           </Member>
           <Member
             name="Dawn Foster"
             title="Independent Non-Executive Director"
             imageUrl="/images/people/dawn@300px.webp"
             url="https://fastwonder.com/"
           >
             <p>
               Board member of <a href="https://chaoss.community/">CHAOSS</a> and <a href="https://openuk.uk/">OpenUK</a>.
               Previous Open Source leadership positions at <a href="https://www.intel.com/">Intel</a>, <a href="https://www.vmware.com/">VMware</a>, and <a href="https://www.puppet.com/">Puppet</a>.
               <a href="https://fastwonderblog.com/academic/">PhD</a> using metrics to study the Linux kernel.
             </p>
           </Member>
           <Member
             name="Matias Capeletto"
             title="Independent Non-Executive Director"
             imageUrl="/images/people/patak@300px.webp"
             url="https://patak.cat"
           >
             <p>
               Steward of <a href="https://npmx.dev">npmx</a>.
               Core developer of foundational web development tools used by millions, such as
               <a href="https://vite.dev/">Vite</a>,
               <a href="https://vitest.dev/">Vitest</a>
               and
               <a href="https://e18e.dev/">e18e</a>.
               Previously at <a href="https://stackblitz.com/">StackBlitz</a>.
             </p>
           </Member>
           <Member
             name="Mike McQuaid"
             title="Adviser"
             imageUrl="/images/people/mike@300px.webp"
             url="https://mikemcquaid.com"
           >
             <p>
               CTPO at <a href="https://www.getadministrate.com/">Administrate</a>.
               Project Leader of <a href="https://brew.sh/">Homebrew</a>.
               Former <a href="https://github.com">GitHub</a> Principal Engineer (#232).
               Author of <a href="https://www.manning.com/books/git-in-practice">Git in Practice</a>.
             </p>
           </Member>
        </div>
        <h2 class="big-heading">Our Experience</h2>
        <div class="logowall-group">
          <span>In leadership roles</span>
          <div class="logowall">
            <a
              class="logo plain-link"
              target="_blank"
              href="https://opensourcepledge.com"
            ><LogoOsp
              style="padding-block: 2px;"
              aria-label="The Open Source Pledge logo"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://endowment.dev"
            ><LogoOse
              aria-label="The Open Source Endowment logo"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://thanks.dev"
            ><LogoThanksDev
              aria-label="The thanks.dev logo"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://ecosyste.ms"
            ><LogoEcosystems
              aria-label="The ecosyste.ms logo"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://libraries.io"
            ><LogoLibrariesIo
              aria-label="The libraries.io logo"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://chaoss.community/"
            ><LogoChaoss
              aria-label="The CHAOSS logo"
              style="padding-block: 8px;"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://nuxt.com/"
            ><LogoNuxt
              aria-label="The Nuxt logo"
              style="padding-block: 8px;"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://vite.dev/"
            ><LogoVite
              aria-label="The Vite logo"
              style="padding-block: 10px;"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://npmx.dev/"
            ><LogoNpmx
              src="/images/logos/npmx.svg"
              aria-label="The npmx logo"
              style="padding-block: 5px;"
              width="104"
              height="40"
            /></a>
          </div>
        </div>
        <div class="logowall-group">
          <span>As contributors</span>
          <div class="logowall">
            <a
              class="logo plain-link"
              target="_blank"
              href="https://engineering.nyu.edu/"
            ><LogoNyu
              aria-label="The NYU logo"
              width="75"
              height="35"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://www.sovereign.tech/"
            ><LogoSta
              aria-label="The Sovereign Tech Agency logo"
              width="95"
              height="35"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://www.gatesfoundation.org/"
            ><LogoGatesFoundation
              aria-label="The Gates Foundation logo"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://intel.com"
            ><LogoIntel
              aria-label="The Intel logo"
              style="padding-block: 6px;"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://www.vmware.com/"
            ><LogoVmware
              aria-label="The VMware logo"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://github.com"
            ><LogoGitHub
              aria-label="The GitHub logo"
              style="padding-block: 8px;"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://www.epfl.ch/en/"
            ><LogoEpfl
              aria-label="The EPFL logo"
              style="padding-block: 5px;"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://alpha-omega.dev/"
            ><LogoAlphaOmega
              aria-label="The Alpha Omega logo"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://openssf.org/"
            ><LogoOpenSsf
              aria-label="The OpenSSF logo"
              style="padding-block: 3px;"
              width="104"
              height="40"
            /></a>
            <a
              class="logo plain-link"
              target="_blank"
              href="https://www.linuxfoundation.org/"
            ><LogoLinuxFoundation
              aria-label="The Linux Foundation logo"
              style="padding-block: 5px;"
              width="104"
              height="40"
            /></a>
          </div>
        </div>
      </div>
    </section>
    <section>
      <div class="bacta">
        <div class="bacta-canvas-container">
          <BactaCanvas />
        </div>
        <div class="container">
          <div class="bacta-head">
            <h2 class="big-heading">Our programs</h2>
          </div>
          <div class="brief-programs">
            {programs.map((program) => (
              <MiniProgram
                id={program.id}
                title={program.title}
                fundedAmount={program.fundedAmount}
                targetAmount={program.targetAmount}
                currency={program.currency}
                aim={program.aim}
                color={program.color}
              >
              </MiniProgram>
            ))}
          </div>
          <div class="cta">
            <a href="/programs" class="button button--inverted">See full programs</a>
          </div>
        </div>
      </div>
    </section>
    <section>
      <div class="container">
        <section>
          <h2 class="big-heading" id="values">
            Values
          </h2>
          <div class="values">
            <div class="labelbox">
              <h3>
                Public good
              </h3>
              <div>
                <p>
                  Our work must provide a clear benefit to the public; and not put them at disproportionate risk of
                  harm, eg via drastic environmental consequences or monopolies.
                </p>
              </div>
            </div>
            <div class="labelbox">
              <h3>
                Public access
              </h3>
              <div>
                <p>
                  All our research outputs are accessible and usable by all. This means Open Source code, open data, and open
                  access research papers.
                </p>
              </div>
            </div>
            <div class="labelbox">
              <h3>
                Systemic improvements
              </h3>
              <div>
                <p>
                  We aim for widely-applicable systemic solutions, not just fixes for particular technologies, so developers
                  don't have to shape themselves to fit a bad system.
                </p>
              </div>
            </div>
            <div class="labelbox">
              <h3>
                Interdisciplinarity
              </h3>
              <div>
                <p>
                  Our work addresses the social, ethical and policy dimensions of Open Source, like responsible governance,
                  good working conditions and respect.
                </p>
              </div>
            </div>
            <div class="labelbox">
              <h3>
                Decentralisation
              </h3>
              <div>
                <p>
                  We promote sharing and distributing power over technology. We want users to be able to shape the tech they
                  use so that it works in their best interests.
                </p>
              </div>
            </div>
            <div class="labelbox">
              <h3>
                Interdependence
              </h3>
              <div>
                <p>
                  We aim to advance public knowledge about how the tech we have today is made possible by webs of
                  interdependence where developers collaborate openly.
                </p>
              </div>
            </div>
          </div>
        </section>
        <section>
          <div class="cta">
            <h2>Ready to protect the Open Source ecosystem?</h2>
            <a href="/sponsor" class="button">Sponsor the Lab</a>
          </div>
        </section>
      </div>
    </section>
  </div>
</MainLayout>

<style>
.hero {
  position: relative;
  margin-block: 30px;
  @media (max-width: 900px) {
    margin-top: 0;
    h2.sechead {
      margin-top: 15px;
    }
  }
  .squiggle--hero {
    bottom: -10px;
    right: 5px;
    width: 30px;
    height: 30px;
  }
  h2.sechead {
    padding-right: 30px;
  }
}
.subhero {
  display: flex;
  flex-direction: column;
  gap: 0;
  @media (max-width: 900px) {
    flex-direction: column-reverse;
    .postcard {
      margin-top: 10px;
      margin-bottom: 40px;
      figcaption {
        display: none;
      }
    }
  }
}
.postcard {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 15px;
  margin-top: 40px;
  margin-bottom: 50px;
  .postcard__main {
    width: auto;
    height: auto;
    border-radius: var(--border-radius-l);
  }
  figcaption {
    position: absolute;
    z-index: 10;
    bottom: -20px;
    right: 20px;
    border-radius: var(--border-radius-s);
  }
}
.news-item {
  display: block;
  margin-bottom: 30px;
  font-size: var(--font-size-xs);
  line-height: var(--line-height-xs);
  text-wrap: balance;
  color: var(--color-blue);
  .news-item__body {
    display: flex;
    align-items: center;
    gap: 25px;
    padding: 15px;
    border-radius: var(--border-radius-s);
    background: var(--color-beige-xpale);
    &:hover {
      background: var(--color-beige-pale);
    }
    @media (max-width: 900px) {
      .news-item__extra {
        display: none;
      }
    }
    .news-item__text {
      flex: 1;
    }
    h2 {
      margin-bottom: 5px;
      color: var(--color-blue);
      font-size: var(--font-size-m);
      line-height: var(--line-height-xs);
    }
  }
  .news-item__graphic {
    width: 65px;
    height: 65px;
    border-radius: var(--border-radius-s);
  }
}
.feature-set {
  display: flex;
  gap: 50px;
  @media (max-width: 900px) {
    display: block;
    margin-bottom: 30px;
  }
  hr {
    display: none;
    margin-block: 25px;
    @media (max-width: 900px) {
      display: block;
    }
  }
}
.feature {
  flex: 1;
  font-size: var(--font-size-s);
  line-height: var(--line-height-s);
  h2 {
    font-family: var(--font-family-sans);
    font-variant-caps: small-caps;
    font-feature-settings: "smcp";
    text-transform: lowercase;
    font-size: var(--font-size-m);
    line-height: var(--line-height-m);
  }
}
.logowall-group {
  display: flex;
  gap: 30px;
  margin-top: 30px;
  @media (max-width: 900px) {
    flex-direction: column;
    gap: 5px;
    margin-top: 20px;
  }
  & > span {
    flex-basis: 200px;
    font-family: var(--font-family-sans);
    font-variant-caps: small-caps;
    font-feature-settings: "smcp";
    text-transform: lowercase;
    @media (max-width: 900px) {
      flex-basis: unset;
    }
  }
  & > .logowall {
    flex: 1;
  }
}
.logowall {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 10px;
  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 15px;
    background: var(--color-beige-pale);
    border: 1px solid var(--color-beige-pale);
    border-radius: var(--border-radius-s);
    transition: background-color 200ms;
    &:hover {
      background: var(--color-beige-pale);
    }
    svg {
      height: 35px;
      opacity: 0.9;
    }
  }
}
.members {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  row-gap: 20px;
  column-gap: 30px;
  margin-block: 30px;
}
.values {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  row-gap: 30px;
  column-gap: 20px;
}
.labelbox {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  h3 {
    display: inline-block;
    position: relative;
    top: 10px;
    margin: 0;
    padding: 10px 15px;
    font-family: var(--font-family-sans);
    font-size: var(--font-size-m);
    line-height: var(--line-height-m);
    font-weight: 500;
    font-variant-caps: small-caps;
    font-feature-settings: "smcp";
    text-transform: lowercase;
    border-top-left-radius: var(--border-radius-l);
    border-top-right-radius: var(--border-radius-l);
    background: var(--color-blue);
    color: white;
  }
  & > div {
    flex: 1;
    margin: 0;
    padding: 15px;
    padding-top: calc(15px + 10px);
    padding-right: 80px;
    font-size: var(--font-size-s);
    line-height: var(--line-height-s);
    border-radius: var(--border-radius-l);
    background:
      url(/images/star-for-bg.svg),
      var(--color-beige-xpale);
    background-repeat: no-repeat;
    background-position: 115% 190%;
    background-size: 110px 110px;
  }
}
.brief-programs {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
</style>
