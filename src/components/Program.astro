---
import { formatUsdAmount, formatGbpAmount } from '../utils/format.ts';
import IconCaretRightBold from '../assets/images/icons/phosphor/caret-right-bold.svg';

interface Resource {
  name: string;
  url: string;
}

interface Props {
  id: string,
  title: string;
  fundedAmount: number;
  targetAmount: number;
  currency: string;
  ocUrl: string;
  aim: string;
  color: string;
  resources: []Resource;
}

let {
  id, title, fundedAmount, targetAmount, currency, ocUrl,
  aim, color, resources
} = Astro.props;

const oneUsdAsGbp = 0.76;
const percentFunded = fundedAmount / targetAmount * 100;
---

<div class="program" id={id}>
  <div class="program__head">
    <div class="program__headtext">
      <h2>{title}</h2>
      <div class="program__aim">{aim}</div>
    </div>
  </div>
  <div class="program__body">
    <div class="program__funding">
      <div class="program__totals">
        <div>
          <i>Funded</i>
          {currency == "gbp" && (
          <span>{formatGbpAmount(fundedAmount)}</span>
          )}
          {currency == "usd" && (
          <span>{formatUsdAmount(fundedAmount)}</span>
          <span class="conversion">
            ({formatGbpAmount(fundedAmount * oneUsdAsGbp)})
          </span>
          )}
        </div>
        <div class="program__goal">
          <i>Goal</i>
          {currency == "gbp" && (
          <span>{formatGbpAmount(targetAmount)}</span>
          )}
          {currency == "usd" && (
          <span class="conversion">
            ({formatGbpAmount(targetAmount * oneUsdAsGbp)})
          </span>
          <span>{formatUsdAmount(targetAmount)}</span>
          )}
        </div>
      </div>
      <div class="program__bar" style={`--percent-funded: ${percentFunded}%`}></div>
    </div>
    <div class="program__desc">
      <slot></slot>
    </div>
    {resources && (
      <div class="program__resources">
        <strong>Resources:</strong>
        {resources.map((resource) => (
          <a href={resource.url} target="_blank" class="program__resource">{resource.name}</a>
        ))}
      </div>
    )}
    <div class="program__cta">
      <a href={ocUrl} target="_blank" class="button">Fund<IconCaretRightBold class="icon icon--s" /></a>
    </div>
  </div>
</div>

<style define:vars={{ programColor: color }}>
</style>
